#!/usr/bin/env python3
"""Сохранить снимки текущего или всех экземпляров kitty."""
import argparse
import os
from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parent))
import background
import ksession


def main():
    parser = argparse.ArgumentParser(description='Сохранить сессии kitty')
    parser.add_argument('--all', action='store_true')
    parser.add_argument('-n', type=int)
    parser.add_argument('--background', action='store_true')
    parser.add_argument('--errors', action='store_true')
    args = parser.parse_args()
    if args.n is not None and not args.all:
        parser.error('-n требует --all')
    if args.n is not None and args.n <= 0:
        parser.error('-n должен быть положительным')
    if args.errors:
        if not sys.stdin.isatty() or not sys.stdout.isatty():
            parser.error('--errors требует терминал')
        background.show_errors()
        return 0
    try:
        config = ksession.load_config()
        ksession.configure(config)
        if config['save']['max_processes'] > config['storage']['max_sessions']:
            print('Предупреждение: save.max_processes больше storage.max_sessions', file=sys.stderr)
        if args.all:
            targets = ksession.list_sockets()
            limit = args.n if args.n is not None else config['save']['max_processes']
            if len(targets) > limit:
                raise ValueError(f'Найдено {len(targets)} процессов, лимит {limit}')
        else:
            pid = os.environ.get('KITTY_PID')
            if not pid or not pid.isdigit():
                raise ValueError('Требуется числовой KITTY_PID')
            sock = ksession.socket_for_pid(pid)
            if not Path(sock).exists():
                raise ValueError(f'Нет сокета {sock}')
            targets = [(int(pid), sock)]
        snapshots = []
        for pid, sock in targets:
            windows = ksession.run_ls(sock)
            if len(windows) >= config['save']['min_os_windows'] and ksession.count_tabs(windows) >= config['save']['min_tabs']:
                snapshots.append(ksession.build_session(windows, pid))
        ksession.save_many(snapshots, config['storage']['max_sessions'])
        if args.background:
            background.succeeded()
        if sys.stdout.isatty():
            from rich.console import Console
            Console().print(f'Сохранено снимков: {len(snapshots)}')
        return 0
    except Exception as exc:
        if args.background:
            try:
                background.failed('сохранение', exc)
            except Exception as report_error:
                print(f'Ошибка записи отчета: {report_error}', file=sys.stderr)
        print(f'savesession: {exc}', file=sys.stderr)
        return 1


if __name__ == '__main__':
    sys.exit(main())
